import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(
    home: EnableDisableExample(),
    debugShowCheckedModeBanner: false,
  ));
}

class EnableDisableExample extends StatefulWidget {
  @override
  State<EnableDisableExample> createState() =>
      _EnableDisableExampleState();
}

class _EnableDisableExampleState extends State<EnableDisableExample> {
  bool isEnabled = true;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text("Enable & Disable"),
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Switch(
              value: isEnabled,
              onChanged: (value) {
                setState(() {
                  isEnabled = value;
                });
              },
            ),
            SizedBox(height: 20),
            ElevatedButton(
              onPressed: isEnabled
                  ? () {
                      print("Button Pressed");
                    }
                  : null, // Disabled when null
              child: Text("Submit"),
            ),
          ],
        ),
      ),
    );
  }
}
